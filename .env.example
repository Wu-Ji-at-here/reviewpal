# ============================================================
# 复盘通 · 环境变量
# 用法：把本文件复制成 .env（同目录），再按下面的说明填。
# ============================================================

# 【第一步】先用 Mock 把动线跑通：保持 MOCK=1
# 【第二步】拿到真实 Key 后：填好 DEEPSEEK_API_KEY，并把 MOCK 改成 0
MOCK=1

# 后端端口（改这里，前端访问地址也要跟着改）
PORT=8787

# 模型 Key：只放在这里，绝对不要写进前端代码
# 去 platform.deepseek.com 控制台创建，形如 sk-xxxxxx
DEEPSEEK_API_KEY=

# 模型 id：必须填官方当前可用的值（以官网当日文档为准）
MODEL_ID=deepseek-v4-flash

# 接口地址：留空/删除 = 用官方 https://api.deepseek.com
# 想接本地模型（Ollama / vLLM 等）时填 OpenAI 兼容地址，例如 http://127.0.0.1:11434/v1
DEEPSEEK_BASE_URL=